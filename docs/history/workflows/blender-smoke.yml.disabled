name: Blender overworld blockout

on:
  workflow_dispatch:
  pull_request:
    paths:
      - 'blender/scripts/**'
      - 'tools/validate_glb.py'
      - 'tools/validate_overworld.py'
      - 'tools/fetch_assets.py'
      - 'tools/assets.lock.json'
      - 'tools/validate_v2.py'
      - '.github/workflows/blender-smoke.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - name: Install headless Blender
        run: |
          sudo apt-get update
          sudo apt-get install -y blender python3-numpy
          blender --version
          blender --background --python-exit-code 1 --python-expr "import numpy; print('NumPy available:', numpy.__version__)"
      - name: Build editable Blender scene and GLB
        run: |
          python3 tools/fetch_assets.py
          blender --background --python-exit-code 1 --python blender/scripts/build_world_v2.py
      - name: Validate layout and GLB
        run: |
          python3 tools/validate_v2.py
          python3 tools/validate_glb.py godot/assets/generated/overworld.glb
      - name: Upload models
        uses: actions/upload-artifact@v4
        with:
          name: telanico-overworld-models
          path: |
            blender/generated/overworld.blend
            godot/assets/generated/overworld.glb
            blender/generated/overworld_layout.json
          if-no-files-found: error
          retention-days: 7
